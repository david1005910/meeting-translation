{
  "name": "multimeet",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend,stt \"npm run dev -w backend\" \"npm run dev -w frontend\" \"npm run stt\"",
    "stt": "bash start-stt.sh",
    "build:win": "node build-windows.js",
    "package:win": "node build-windows.js && cd dist-win && zip -rq ../MultiMeet-Windows-x64.zip . -x '*.DS_Store'",
    "db:studio": "npm exec -w backend -- prisma studio",
    "db:migrate": "npm exec -w backend -- prisma migrate dev"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron-builder": "^26.15.3",
    "pkg": "^5.8.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true
  }
}
